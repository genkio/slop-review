{
  "name": "slop-review",
  "version": "0.4.0",
  "type": "module",
  "description": "Local PR-review loop for human ↔ LLM. Run inside any git repo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genkio/slop-review.git"
  },
  "homepage": "https://github.com/genkio/slop-review#readme",
  "bugs": {
    "url": "https://github.com/genkio/slop-review/issues"
  },
  "bin": {
    "slop-review": "bin/slop-review.js"
  },
  "files": [
    "bin",
    "server",
    "public",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/slop-review.js",
    "dev": "node --watch-path=./server bin/slop-review.js --no-open",
    "test": "node --test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  }
}
